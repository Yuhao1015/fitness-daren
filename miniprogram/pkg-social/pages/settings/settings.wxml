<view class="screen">
  <page-header over="设置" title="设置与隐私" num="" num-label="" />
  <view class="panel">
    <scroll-view class="scroll" scroll-y>
      <view class="content stack-24">
        <view class="stack-8">
          <text class="t16 b">训练目标</text>
          <view class="grid-3"><view wx:for="{{goals}}" wx:key="key" class="chip t14" aria-role="button" aria-selected="{{item.on}}" style="border-color:{{item.bd}};background:{{item.bg}};color:{{item.fg}}" data-id="{{item.id}}" bindtap="onGoal">{{item.label}}</view></view>
        </view>
        <view class="stack-8">
          <text class="t16 b">每周目标</text>
          <view class="grid-4"><view wx:for="{{targets}}" wx:key="key" class="chip t14" aria-role="button" aria-selected="{{item.on}}" style="border-color:{{item.bd}};background:{{item.bg}};color:{{item.fg}}" data-id="{{item.id}}" bindtap="onTarget">{{item.label}}</view></view>
        </view>
        <view class="stack-4">
          <text class="t16 b">体重（kg，选填）</text>
          <input class="input input-plain" type="digit" placeholder="只用于估算，不会出现在分享内容里" value="{{bodyweight}}" bindblur="onWeight" bindconfirm="onWeight" />
        </view>
        <view class="row-between card set-row" aria-role="switch" aria-checked="{{motion}}" bindtap="onMotion">
          <view class="stack-2"><text class="t14 b">庆祝动效</text><text class="t12 c2">获得徽章时的彩纸动画</text></view>
          <view class="switch" style="background:{{motion ? '#2E7D4F' : '#B4BEB6'}}"><view class="knob" style="transform:translateX({{motion ? 38 : 0}}rpx)"></view></view>
        </view>
        <view class="stack-8">
          <view class="btn btn-ghost" hover-class="is-pressed" aria-role="button" bindtap="onPrivacy">查看隐私保护指引</view>
          <view class="btn btn-ghost" hover-class="is-pressed" aria-role="button" bindtap="onExport">导出我的数据</view>
          <view class="btn btn-danger" hover-class="is-pressed" aria-role="button" bindtap="onDelete">注销并删除全部数据</view>
        </view>
      </view>
    </scroll-view>
  </view>
  <toast id="toast" />
</view>
