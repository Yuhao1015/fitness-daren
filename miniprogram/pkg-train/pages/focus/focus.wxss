.focus { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: #FFFFFF; display: flex; flex-direction: column; }
.f-top { background: var(--header-bg); padding: 0 38rpx 38rpx; display: flex; flex-direction: column; gap: 12rpx; border-radius: 0 0 54rpx 54rpx; }
.f-name { font-size: 54rpx; font-weight: 700; }
.f-dots { margin-top: 8rpx; }
.f-dot { width: 23rpx; height: 23rpx; border-radius: 999px; }
.f-rest { margin: 31rpx 35rpx 0; padding: 31rpx; border-radius: var(--r-md); background: var(--tint); display: flex; flex-direction: column; align-items: center; gap: 15rpx; }
.f-clock { font-size: 123rpx; line-height: 123rpx; font-weight: 700; color: var(--green-dark); }
.f-track { width: 100%; height: 15rpx; border-radius: 999px; background: #FFFFFF; overflow: hidden; }
.f-fill { height: 15rpx; border-radius: 999px; background: var(--green); transition: width 0.25s linear; }
.f-main { flex: 1; padding: 38rpx 35rpx; display: flex; flex-direction: column; gap: 38rpx; }
.f-stepper { display: flex; flex-direction: column; align-items: center; gap: 15rpx; }
.f-row { width: 100%; display: flex; align-items: center; justify-content: space-between; }
.f-btn { width: 123rpx; height: 123rpx; border-radius: 999px; border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; }
.f-val { display: flex; align-items: baseline; gap: 8rpx; }
.f-num { font-size: 115rpx; line-height: 115rpx; font-weight: 700; }
.f-quick { justify-content: center; }
.f-foot { padding: 23rpx 35rpx calc(31rpx + env(safe-area-inset-bottom)); border-top: 1px solid var(--border); }

.f-pr { align-self: flex-start; display: flex; align-items: center; gap: 8rpx; background: var(--warn-bg); color: var(--warn-fg); border-radius: 999px; padding: 8rpx 19rpx 8rpx 15rpx; font-size: 27rpx; font-weight: 700; }
.f-title { display: flex; align-items: center; gap: 15rpx; }
.f-figure { flex: none; width: 104rpx; height: 104rpx; border-radius: var(--r-sm); background: #FFFFFF; display: flex; align-items: center; justify-content: center; }
