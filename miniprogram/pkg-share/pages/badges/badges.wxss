.bdg { border: 1px solid var(--border); border-radius: var(--r-md); padding: 23rpx 12rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; text-align: center; }
.locked { opacity: 0.7; }
.medal { width: 100rpx; height: 100rpx; border-radius: 999px; display: flex; align-items: center; justify-content: center; }
.track { width: 100%; height: 10rpx; border-radius: 999px; background: var(--track); overflow: hidden; }
.fill { height: 10rpx; background: var(--green); }
.foot { padding: 23rpx 35rpx calc(31rpx + env(safe-area-inset-bottom)); border-top: 1px solid var(--border); }
