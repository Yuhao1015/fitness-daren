.poster-page { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20, 30, 24, 0.92); display: flex; flex-direction: column; align-items: center; padding: 0 38rpx calc(54rpx + env(safe-area-inset-bottom)); box-sizing: border-box; gap: 27rpx; }
.bar { align-self: stretch; display: flex; align-items: center; justify-content: space-between; }
.white { color: #FFFFFF; }
.sb { font-weight: 600; }
.close { width: 85rpx; height: 85rpx; border-radius: 999px; background: rgba(255, 255, 255, 0.16); display: flex; align-items: center; justify-content: center; }
.sheet { flex: 1; min-height: 0; width: 596rpx; display: flex; align-items: center; justify-content: center; overflow-y: auto; }
.poster { width: 596rpx; border-radius: 38rpx; box-shadow: 0 38rpx 77rpx rgba(0, 0, 0, 0.3); }
.placeholder { width: 596rpx; height: 800rpx; border-radius: 38rpx; background: #FFFFFF; display: flex; align-items: center; justify-content: center; }
.actions { width: 596rpx; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15rpx; }
.btn-ghost-dark { height: 92rpx; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.6); color: #FFFFFF; font-size: 31rpx; font-weight: 600; }
.tip { font-size: 23rpx; color: rgba(255, 255, 255, 0.75); }
.offscreen { position: fixed; left: -9999px; top: 0; width: 310px; height: 600px; }
