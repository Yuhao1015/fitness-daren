.cell { border: 1px solid var(--border); border-radius: var(--r-md); padding: 19rpx 8rpx; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.locked { filter: grayscale(1) brightness(1.5); opacity: 0.55; }
.foot { padding: 23rpx 35rpx calc(31rpx + env(safe-area-inset-bottom)); border-top: 1px solid var(--border); }
