<view class="screen">
  <page-header over="海报册" title="我的打卡海报" num="" num-label="" />
  <view class="panel">
    <scroll-view class="scroll" scroll-y>
      <view class="content stack-20">
        <text wx:if="{{!groups.length}}" class="t14 c2">还没有生成过海报。完成一次训练后点「生成打卡海报」，就会收进这里。</text>
        <view wx:for="{{groups}}" wx:for-item="g" wx:key="key" class="stack-8">
          <text class="t16 b">{{g.month}}</text>
          <view class="grid-2">
            <view wx:for="{{g.items}}" wx:key="key" class="item {{item.report ? 'report' : ''}}" hover-class="is-pressed" aria-role="button" data-id="{{item.id}}" bindtap="onOpen">
              <ui-icon name="{{item.report ? 'report' : 'poster'}}" color="#1F5C38" size="46" />
              <text class="t14 b">{{item.title}}</text>
              <text class="t12 c2">{{item.date}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="foot"><view class="btn btn-ghost" hover-class="is-pressed" aria-role="button" bindtap="onBack">返回</view></view>
  </view>
</view>
