.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20, 30, 24, 0.5); z-index: 2000; display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #FFFFFF; border-radius: 54rpx 54rpx 0 0; padding: 38rpx 38rpx calc(38rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; gap: 31rpx; box-sizing: border-box; }
.link { color: var(--green-dark); font-weight: 600; }
