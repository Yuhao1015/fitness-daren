.cel-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(20, 30, 24, 0.72); z-index: 3000; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.bit { position: absolute; top: -31rpx; width: 15rpx; height: 27rpx; border-radius: 4rpx; animation: fall 0.8s ease-in forwards; }
@keyframes fall { to { top: 110%; opacity: 0.2; } }
.cel-card { width: 600rpx; background: #FFFFFF; border-radius: 54rpx; padding: 46rpx 38rpx 38rpx; display: flex; flex-direction: column; align-items: center; gap: 19rpx; text-align: center; }
.pop { animation: pop 0.35s ease-out; }
@keyframes pop { from { transform: scale(0.8); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.medal { width: 185rpx; height: 185rpx; border-radius: 999px; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 12rpx #EAF5EA; margin: 12rpx 0; }
.cel-actions { width: 100%; margin-top: 15rpx; }
